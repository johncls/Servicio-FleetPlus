{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "MaxAttempts": 5,
    "DatabaseTimeoutSeconds": 5
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "User": "fleetplus",
    "Exchange": "fleetpulse.telemetry",
    "Queue": "fleetpulse.telemetry",
    "RetryQueue": "fleetpulse.telemetry.retry",
    "DeadLetterExchange": "fleetpulse.telemetry.dlx",
    "DeadLetterQueue": "fleetpulse.telemetry.dlq",
    "RoutingKey": "telemetry"
  }
}
