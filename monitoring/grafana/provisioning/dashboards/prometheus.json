{
  "uid": "fleetpulse-prometheus",
  "title": "Prometheus",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus en marcha",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Caído", "color": "red" }, "1": { "text": "En marcha", "color": "green" } } }
          ]
        }
      },
      "targets": [{ "refId": "A", "expr": "up" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Series guardadas",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "prometheus_tsdb_head_series" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memoria del proceso",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes" }]
    }
  ]
}
